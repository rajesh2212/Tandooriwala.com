# Every value the restaurant's server reads. Copy this to `.env` for local use, or set the
# same names in the hosting platform's secret/environment UI. `.env` is gitignored: a real
# key never belongs in the repository, and nothing here reaches the browser bundle.
#
# `npm start` loads `.env` by itself (Node's `--env-file-if-exists`), and Vite reads it for
# the `VITE_*` names at build time — so locally you only create the file and fill it in.
# Nothing here is required to run the site on a laptop; the defaults all work.
#
# For a public deployment, DEPLOYING.md is the short version of this file.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# `production` turns on the boot guards, the HTTPS redirect, HSTS and the Secure cookie.
# Leave it unset locally — the app then runs on plain http://localhost, which is what a
# laptop test needs.
NODE_ENV=production

# The port to listen on. Most platforms set this themselves; 8787 is the local default.
PORT=8787

# REQUIRED IN PRODUCTION. The public origin of the site, https, no trailing slash, never
# localhost: it is what the session cookie is marked Secure for, what the Origin check
# accepts, and where plain-HTTP visitors get sent.
TRUSTED_ORIGIN=https://tandooriwala.example

# How many proxies sit in front of this process. One is right for Fly.io, Railway, Render
# and a plain nginx/Caddy setup. Set 2 if the platform documents two hops; leaving it too
# high lets a client forge X-Forwarded-For and slip past the rate limits.
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# The key that unlocks GET/PATCH /api/enquiries and /api/bookings, and therefore /admin.
# Without it the inbox still accepts messages but nobody can read them. Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# There is no other secret: passwords are scrypt-hashed and session tokens are random bytes
# whose SHA-256 is stored, so nothing needs signing with a key.
TANDOORIWALA_ADMIN_KEY=replace-me-with-a-long-random-string

# ---------------------------------------------------------------------------
# Where the data lives — both must be on a persistent disk
# ---------------------------------------------------------------------------

# SQLite file. Migrations apply themselves when the server starts.
DATA_FILE=data/enquiries.db

# Profile photos. The folder is never published; the API is the only way in.
UPLOAD_DIR=data/uploads/avatars

# On a container platform, point both at the mounted volume, e.g.
#   DATA_FILE=/data/enquiries.db
#   UPLOAD_DIR=/data/uploads/avatars

# ---------------------------------------------------------------------------
# The restaurant's clock (setup values)
# ---------------------------------------------------------------------------

# IANA zone name. Seating times and the "is today" cut-off are read in this zone, so a
# customer in another country sees the same evening the kitchen is cooking.
RESTAURANT_TIMEZONE=Asia/Kolkata

# Fallback used only if the Node build has no timezone data. Must match the zone above.
RESTAURANT_UTC_OFFSET=+05:30

# ---------------------------------------------------------------------------
# Only when the site and this API are hosted on different origins
# ---------------------------------------------------------------------------

# Exact origins allowed to send credentialed requests to /api. Leave empty for the normal
# single-host deployment, where Express serves the built site itself and no CORS is needed.
# ALLOWED_ORIGINS=https://tandooriwala.example

# Leave at Lax unless the site is on another origin, in which case None (HTTPS only).
# COOKIE_SAME_SITE=Lax

# Build-time (compiled into the bundle, so it is readable by anyone who views source —
# a URL only, never a key). Only needed for the split layout: it is the origin the API
# above must list, and it also stamps the canonical and Open Graph tags.
# VITE_API_ORIGIN=https://api.tandooriwala.example
# VITE_SITE_ORIGIN=https://tandooriwala.example

# ---------------------------------------------------------------------------
# Dev only
# ---------------------------------------------------------------------------

# What the Vite dev server proxies /api to. Never used by a production build.
# API_URL=http://localhost:8787
